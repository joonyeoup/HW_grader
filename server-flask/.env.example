# Server Configuration
PORT=3000
NODE_ENV=production

# OpenAI API Configuration (YOUR API KEY - KEPT SECRET)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
MAX_TOKENS=1000
TEMPERATURE=0.3

# CORS - Allowed origins (comma-separated)
# For Chrome extension, use: chrome-extension://*
# For production, add your extension ID: chrome-extension://your-extension-id-here
ALLOWED_ORIGINS=chrome-extension://*

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Database (optional - for production)
# MONGODB_URI=mongodb://localhost:27017/gradescope-grader
# or
# DATABASE_URL=postgresql://user:password@localhost:5432/gradescope_grader

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
